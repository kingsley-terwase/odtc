# Address of the ODTC backend that uses Google Places (no trailing slash, no /api/v1). Set this to your deployed Google-places backend.
VITE_API_URL=https://your-google-places-backend.example.com

# Google Identity Services web client ID. Enables the "Continue with Google" button on /signin and /signup (button is hidden when empty).
# The same client ID must be configured as GOOGLE_CLIENT_ID on the backend.
VITE_GOOGLE_CLIENT_ID=
