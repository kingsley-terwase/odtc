generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  ADMIN
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(254)
  name            String    @db.VarChar(120)
  passwordHash    String?
  googleId        String?   @unique
  emailVerifiedAt DateTime?
  verificationTokenHash String? @unique @db.Char(64)
  verificationExpiresAt DateTime?
  verificationRequestedAt DateTime?
  role            UserRole  @default(CLIENT)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sessions        Session[]
  pricingPolicies PricingPolicy[]
  serviceAreas ServiceArea[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @db.Char(64)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PricingPolicy {
  quotes DeliveryQuote[]
  id          Int      @id @default(autoincrement())
  ratePerKm   Decimal  @db.Decimal(12, 2)
  minimumFare Decimal  @db.Decimal(12, 2)
  currency    String   @default("NGN") @db.Char(3)
  createdById String   @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
}

enum ServiceAreaType {
  CITY
  LGA
}

model ServiceArea {
  subdivisions ServiceSubdivision[]
  aliases String[] @default([]) @db.VarChar(120)
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @db.VarChar(120)
  state           String          @db.VarChar(120)
  countryCode     String          @db.Char(2)
  type            ServiceAreaType
  normalizedName  String          @db.VarChar(120)
  normalizedState String          @db.VarChar(120)
  active          Boolean         @default(true)
  createdById     String          @db.Uuid
  createdBy       User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([countryCode, normalizedState, normalizedName, type])
  @@index([active])
}

model DeliveryQuote {
  id              String        @id @default(uuid()) @db.Uuid
  pickup          Json
  delivery        Json
  distanceMeters  Decimal       @db.Decimal(12, 2)
  ratePerKm       Decimal       @db.Decimal(12, 2)
  minimumFare     Decimal       @db.Decimal(12, 2)
  totalFare       Decimal       @db.Decimal(12, 2)
  pricingPolicyId Int
  pricingPolicy   PricingPolicy @relation(fields: [pricingPolicyId], references: [id], onDelete: Restrict)
  accessTokenHash String        @db.Char(64)
  expiresAt       DateTime
  createdAt       DateTime      @default(now())
  booking         Booking?
}

enum BookingStatus {
  AWAITING_PAYMENT
  CONFIRMED
}

enum ReceiptStatus {
  PENDING
  SENDING
  SENT
}

model Booking {
  id                 String        @id @default(uuid()) @db.Uuid
  reference          String        @unique
  quoteId            String        @unique @db.Uuid
  quote              DeliveryQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  accessTokenHash    String        @db.Char(64)
  fullName           String        @db.VarChar(120)
  phone              String        @db.VarChar(30)
  email              String        @db.VarChar(254)
  packageDescription String
  packageSize        String?       @db.VarChar(80)
  status             BookingStatus @default(AWAITING_PAYMENT)
  authorizationUrl   String?
  paidAt             DateTime?
  receiptStatus      ReceiptStatus @default(PENDING)
  receiptAttemptAt   DateTime?
  createdAt          DateTime      @default(now())

  @@index([status, receiptStatus, receiptAttemptAt])
}

model ServiceSubdivision {
  id String @id @default(uuid()) @db.Uuid
  serviceAreaId String @db.Uuid
  serviceArea ServiceArea @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)
  name String @db.VarChar(120)
  normalizedName String @db.VarChar(120)
  mapboxId String? @db.VarChar(300)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([serviceAreaId, normalizedName])
  @@unique([serviceAreaId, mapboxId])
  @@index([normalizedName, active])
  @@index([mapboxId, active])
}
