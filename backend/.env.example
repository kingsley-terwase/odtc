NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Comma-separated frontend origins. Empty means no cross-origin browser access.
CORS_ORIGINS=
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/DATABASE_NAME?schema=public"

SESSION_TTL_HOURS=24
# Set to your Google OAuth web client ID to enable Google sign-in.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Configure locally; do not commit real credentials.
SENDLIB_API_KEY=
SENDLIB_FROM_EMAIL=
EMAIL_TIMEOUT_MS=10000

EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
VERIFICATION_TTL_MINUTES=30
VERIFICATION_COOLDOWN_SECONDS=60

MAPBOX_ACCESS_TOKEN=
PAYSTACK_SECRET_KEY=
PAYSTACK_ALLOW_LIVE=false
PAYSTACK_CALLBACK_URL=
QUOTE_TTL_MINUTES=15
